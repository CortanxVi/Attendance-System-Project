limit_req_zone $binary_remote_addr zone=attendance_api:10m rate=30r/s;
limit_conn_zone $binary_remote_addr zone=attendance_conn:10m;

server {
    listen 80;
    listen [::]:80;
    server_name api.attendance.example.ac.th;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name api.attendance.example.ac.th;
    server_tokens off;

    ssl_certificate /etc/letsencrypt/live/api.attendance.example.ac.th/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/api.attendance.example.ac.th/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:AttendanceTLS:10m;
    ssl_session_timeout 1d;
    ssl_session_tickets off;

    client_max_body_size 32m;
    limit_conn attendance_conn 40;

    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "no-referrer" always;
    add_header X-Frame-Options "DENY" always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;

    location /api/ {
        limit_req zone=attendance_api burst=120 nodelay;
        proxy_pass http://127.0.0.1:8000;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Request-ID $request_id;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_connect_timeout 3s;
        proxy_send_timeout 75s;
        proxy_read_timeout 75s;
        proxy_buffering off;
    }

    location = /health/live {
        proxy_pass http://127.0.0.1:8000/health/live;
        access_log off;
    }

    location = /health/ready {
        allow 127.0.0.1;
        allow ::1;
        deny all;
        proxy_pass http://127.0.0.1:8000/health/ready;
        access_log off;
    }

    location / {
        return 404;
    }
}
