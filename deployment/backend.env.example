APP_ENV=production
APP_VERSION=1.0.0
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_KEY=<server-only-service-role-key>
OCR_SERVICE_URL=http://127.0.0.1:3001
OCR_SERVICE_TOKEN=<random-token-at-least-32-characters>
LIVENESS_SIGNING_KEY=<different-random-token-at-least-32-characters>
TEMP_ADMIN_PIN_PEPPER=<different-random-token-at-least-32-characters>
INSIGHTFACE_MODEL_ROOT=/var/lib/km-attendance/insightface
FACE_INFERENCE_CONCURRENCY=2
LIVENESS_PAD_THRESHOLD=0.65
LIVENESS_PAD_CONCURRENCY=2
FACE_ENROLLMENT_CHALLENGE_SECONDS=180
OCR_TIMEOUT_SECONDS=42
QR_REFRESH_SECONDS=12
QR_CHALLENGE_SECONDS=420
MAX_IMAGE_BYTES=8388608
MAX_IMAGE_WIDTH=4096
MAX_IMAGE_HEIGHT=4096
MAX_IMAGE_PIXELS=16000000
OCR_UPLOAD_REQUEST_MAX_BYTES=9437184
ATTENDANCE_VERIFY_REQUEST_MAX_BYTES=16777216
SUPPORT_ATTACHMENT_MAX_BYTES=10485760
SUPPORT_MAX_ATTACHMENTS_PER_MESSAGE=3
SUPPORT_UPLOAD_REQUEST_MAX_BYTES=32505856
ROSTER_IMPORT_REQUEST_MAX_BYTES=6291456
CORS_ORIGINS=https://attendance.example.ac.th
TRUSTED_HOSTS=attendance.example.ac.th,127.0.0.1,localhost
TEMP_ADMIN_GRANT_SECONDS=600
TEMP_ADMIN_ENROLLMENT_SECONDS=86400
TEMP_ADMIN_MAX_PIN_ATTEMPTS=5
TEMP_ADMIN_LOCK_SECONDS=900
