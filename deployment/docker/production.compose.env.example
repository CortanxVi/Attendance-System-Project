# Copy this file to /etc/km-attendance/compose.env on the Mini PC.
# This file contains deployment topology, not application credentials.

# Use a new immutable identifier for every release, preferably the Git tag.
RELEASE_ID=v1.0.0

# Exact public names. FRONTEND_ORIGINS is comma-separated; each origin includes
# https:// but has no trailing slash. Prefer one canonical Production origin.
# API_HOST is a hostname only: no scheme, path, or port.
FRONTEND_ORIGINS=https://app.attendance.example.ac.th
API_HOST=api.attendance.example.ac.th

# Host files and model directory. Application secrets live outside the repository.
ATTENDANCE_CONFIG_DIR=/etc/km-attendance
INSIGHTFACE_MODEL_ROOT_HOST=/var/lib/km-attendance/insightface

# Nginx is the only public entry point; keep FastAPI bound to host loopback.
BACKEND_BIND_ADDRESS=127.0.0.1
BACKEND_PORT=8000

# Conservative defaults for a four-core, 8-GB Mini PC.
BACKEND_MEMORY_LIMIT=4g
BACKEND_CPU_LIMIT=3.0
OCR_MEMORY_LIMIT=2g
OCR_CPU_LIMIT=2.0
FACE_INFERENCE_CONCURRENCY=2
LIVENESS_PAD_CONCURRENCY=2
