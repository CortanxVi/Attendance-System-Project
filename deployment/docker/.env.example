# Copy this file to deployment/docker/.env. This file contains no application
# secrets; Backend and OCR secrets continue to come from their ignored .env files.

# Absolute host path containing models/buffalo_s/*.onnx.
INSIGHTFACE_MODEL_ROOT_HOST=/absolute/path/to/.insightface

# Keep the API loopback-only. ngrok connects to this local listener and provides HTTPS.
BACKEND_BIND_ADDRESS=127.0.0.1
BACKEND_PORT=8000

# Exact browser origins, comma-separated. Add the stable Vercel/Netlify preview URL.
# Example: https://attendance-demo31.vercel.app
STAGING_FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# For localhost-only startup use these defaults. Before opening ngrok, add only
# the ngrok hostname (without https://) that was assigned to this staging run.
STAGING_TRUSTED_HOSTS=127.0.0.1,localhost

# Conservative defaults for this 4-core / 8-GB development machine.
BACKEND_MEMORY_LIMIT=4g
BACKEND_CPU_LIMIT=3.0
OCR_MEMORY_LIMIT=2g
OCR_CPU_LIMIT=2.0
FACE_INFERENCE_CONCURRENCY=2
LIVENESS_PAD_CONCURRENCY=2
