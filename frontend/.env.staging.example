# Example values for a Frontend PREVIEW build that talks to a Backend exposed by
# ngrok (see deployment/docker/README_TH.md section 5). Set these as Environment Variables
# in the hosting dashboard (for example Vercel -> Preview). Do not put real values in this file and never commit them.
#
# Variables are baked into the bundle at build time: after changing one, the
# Preview must be redeployed.

# Public values only. These must belong to the same Supabase project that
# backend/.env points to, otherwise the Backend rejects the access token.
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<publishable-or-anon-key>

# The HTTPS origin ngrok prints. HTTPS, no path, no trailing slash.
# The free ngrok development domain is stable between runs.
VITE_API_ORIGIN=https://<your-domain>.ngrok-free.dev
