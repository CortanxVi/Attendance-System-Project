# Example values for a Frontend PREVIEW build that talks to a Backend exposed by
# ngrok (see scripts/start_backend_ngrok.sh). Set these as Environment Variables
# in the hosting dashboard (for example Vercel -> Preview, limited to the
# tuningModel branch). Do not put real values in this file and never commit them.
#
# Variables are baked into the bundle at build time: after changing one, the
# Preview must be redeployed.

# Public values only. These must belong to the same Supabase project that
# backend/.env points to, otherwise the Backend rejects the access token.
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<publishable-or-anon-key>

# Origin printed by scripts/start_backend_ngrok.sh. HTTPS, no path, no trailing slash.
# The free ngrok development domain is stable between runs.
VITE_API_ORIGIN=https://<your-domain>.ngrok-free.dev

# OPTIONAL, test builds only. Shows a red banner and replaces the QR step with a
# list of open sessions of the listed test courses (needs the Backend to run with
# `scripts/start_backend_ngrok.sh start --test-mode`). Never set it for a release:
# scripts/build_release_bundle.sh and scripts/production_preflight.py refuse it.
# VITE_TEST_MODE=1
