# Values in VITE_* variables are public and are included in the browser bundle.
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<publishable-or-anon-key>
# Leave empty for the Vite development proxy or a same-origin reverse proxy.
# For a cloud frontend + Mini PC backend, use only the backend HTTPS origin.
# Do not add /api/v1 and do not put secrets in any VITE_* value.
VITE_API_ORIGIN=
